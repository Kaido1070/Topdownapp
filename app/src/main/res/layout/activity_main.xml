<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- خلفية زخرفية تُموَّه لإبراز تأثير الزجاج -->
    <FrameLayout
        android:id="@+id/blobs"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-120dp"
            android:layout_marginTop="-140dp"
            android:background="@drawable/bg_blob" />
        <View
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-140dp"
            android:layout_marginBottom="-120dp"
            android:alpha="0.8"
            android:background="@drawable/bg_blob" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- الشريط العلوي الزجاجي -->
        <FrameLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_glass"
            android:elevation="6dp"
            android:outlineSpotShadowColor="@color/glass_shadow">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_sheen" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_brand_gradient"
                    android:contentDescription="@string/app_name"
                    android:padding="7dp"
                    android:src="@drawable/ic_logo_glyph" />

                <LinearLayout
                    android:id="@+id/titleBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/pageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textColor="@color/on_bg"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pageUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textColor="@color/on_bg_muted"
                        android:textDirection="ltr"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReload"
                    style="@style/Topdown.GlassIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/reload"
                    app:icon="@drawable/ic_reload" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMore"
                    style="@style/Topdown.GlassIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/settings"
                    app:icon="@drawable/ic_more" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="18dp"
                android:indeterminate="false"
                android:visibility="invisible"
                app:indicatorColor="@color/brand"
                app:trackColor="@android:color/transparent"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.topdown.app.TopdownWebView
                    android:id="@+id/web"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- شاشة الخطأ / عدم الاتصال -->
            <LinearLayout
                android:id="@+id/errorView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="24dp"
                android:background="@drawable/bg_glass_strong"
                android:elevation="8dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/errorIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_brand_gradient"
                    android:contentDescription="@null"
                    android:padding="16dp"
                    android:src="@drawable/ic_wifi_off"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/errorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/no_internet_title"
                    android:textColor="@color/on_bg"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/errorMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/no_internet_msg"
                    android:textColor="@color/on_bg_muted"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/retry"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_reload" />
            </LinearLayout>

            <TextView
                android:id="@+id/offlineBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_strong"
                android:elevation="6dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/offline_banner"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- زر الوسائط المكتشفة (اختيار الجودة) -->
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fabMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="96dp"
                android:text="@string/download_media"
                android:textColor="@android:color/white"
                android:visibility="gone"
                app:backgroundTint="@color/brand"
                app:icon="@drawable/ic_download"
                app:iconTint="@android:color/white" />

            <!-- الشريط السفلي الزجاجي العائم -->
            <FrameLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="20dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_strong"
                android:elevation="10dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_sheen" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBack"
                        style="@style/Topdown.GlassIcon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/back"
                        app:icon="@drawable/ic_back"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnForward"
                        style="@style/Topdown.GlassIcon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/forward"
                        app:icon="@drawable/ic_forward"
                        app:iconGravity="textStart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHome"
                        style="@style/Topdown.GlassIcon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/home"
                        app:icon="@drawable/ic_home"
                        app:iconGravity="textStart"
                        app:iconTint="@color/brand" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownloads"
                            style="@style/Topdown.GlassIcon"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/downloads"
                            app:icon="@drawable/ic_download"
                            app:iconGravity="textStart" />

                        <TextView
                            android:id="@+id/downloadBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="18dp"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_brand_gradient"
                            android:gravity="center"
                            android:minWidth="18dp"
                            android:paddingHorizontal="4dp"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSettings"
                        style="@style/Topdown.GlassIcon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:contentDescription="@string/settings"
                        app:icon="@drawable/ic_settings"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- حاوية ملء الشاشة لمشغل الفيديو -->
    <FrameLayout
        android:id="@+id/fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />
</FrameLayout>
